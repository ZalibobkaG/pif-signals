# --- Telegram userbot (Telethon): чтение группы с сигналами ---
# api_id / api_hash: https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Имя файла сессии в tg_sessions/ (создаётся при первом входе)
TG_SESSION=tg_monitor_session
# Forum-группа и топики, которые слушаем (id через запятую)
TG_GROUP_ID=-1001234567890
TG_TOPIC_IDS=3,4
# Канал для старого монитора utils/tg_channel_monitor.py (опционально)
TG_CHANNEL=

# --- Telegram-бот (aiogram): подтверждение сигналов и уведомления ---
TG_BOT_TOKEN=
# Единственный пользователь, которому бот отвечает
TG_USERNAME=@your_username
# Чат для уведомлений (бот присылает chat_id по команде /start)
TG_NOTIFY_CHAT_ID=
# Альтернативный адрес Bot API (опционально)
# TG_API_BASE=https://api.telegram.org

# --- LLM (DeepSeek через OpenAI-совместимый API) ---
AI_API_KEY=

# --- Биржи ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
